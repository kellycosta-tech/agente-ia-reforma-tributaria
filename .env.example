# ============================================================
# CONFIGURAÇÃO DO LLM
# ============================================================

# Provider utilizado pelo agente.
# Valores possíveis:
# fake   = testes locais sem API externa
# gemini = execução real com Gemini API
LLM_PROVIDER=fake

# Chave da API Gemini.
# NÃO coloque sua chave real neste arquivo.
GEMINI_API_KEY=

# Modelo Gemini utilizado pelo agente.
GEMINI_MODEL=gemini-3.6-flash